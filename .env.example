APP_NAME=Lodgix
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Dar_es_Salaam
# Leave this false everywhere except an explicitly disposable SQLite test DB.
DB_ALLOW_DESTRUCTIVE_COMMANDS=false
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Public branding. These are examples only; do not put secrets or a real
# production URL in this file.
HOTEL_PUBLIC_PRODUCT_NAME=Lodgix
HOTEL_PUBLIC_SHORT_NAME=Lodgix
HOTEL_BRAND_TAGLINE=Hotel Management System
HOTEL_PUBLIC_LOGO_LIGHT=assets/branding/lodgix.png
HOTEL_PUBLIC_LOGO_DARK=assets/branding/lodgix.png
HOTEL_PUBLIC_MARK=assets/branding/lodgix-mark.png
HOTEL_PUBLIC_FAVICON=favicon.ico
HOTEL_PUBLIC_APPLE_TOUCH_ICON=apple-touch-icon.png
HOTEL_SUPPORT_EMAIL=
HOTEL_SUPPORT_URL=
HOTEL_SETUP_ENABLED=false

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci
# MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_URL=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="noreply@your-domain.tld"
MAIL_FROM_NAME="${APP_NAME}"
HOTEL_ALLOW_RESERVED_EMAILS=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# One-time administrative recovery only. Set temporarily, run the controlled
# bootstrap procedure, then remove it. Never use DatabaseSeeder casually on a
# populated production database.
# ADMIN_RESET_PASSWORD=
